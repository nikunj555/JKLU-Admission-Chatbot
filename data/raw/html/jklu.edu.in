<section class="home_campus">
    <div class="container">
        <h2 class="title_head" data-aos="fade-up" data-aos-duration="500" data-aos-delay="300">
            Campus Life</h2>
        <div class="row">
            <div class="col-box1">
                <div class="cmapus_text_head">
                    <blockquote class="block_text1 image">At JK Lakshmipat University, students immerse themselves in a dynamic community, enriched by a kaleidoscope of activities tailored to their passions and interests.</blockquote>
<p>From spirited academic debates to collaborative projects, cultural festivals, and sports competitions, our campus buzzes with excitement and creativity.</p>                </div>
            </div>

                        <div class="col-box1">
                <div class="box-text color-1">
                    <h3 data-aos="fade-up" data-aos-duration="800">Festivals</h3>
                    <p data-aos="fade-up" data-aos-duration="1200" data-aos-delay="300">A vibrant lineup of cultural, academic, and tech fests that bring the campus alive with energy, creativity, and collaboration.</p>                    <a  area-label="View Campus Facilities" href="https://jklu.edu.in/campus-life/festivals"
                        data-aos="fade-up" data-aos-duration="800" data-aos-delay="350"><img
                            src="https://jklu.edu.in/siteassets/images/icons/arrow-white.svg" alt="arrow" width="24" height="24"></a>
                </div>
            </div>
            <div class="col-box1">
                <div class="img-block"><img loading="lazy" src="https://jklu.edu.in/uploads/spotlight/festival-pic.webp"
                        class="img-fluid image" alt="Festivals">
                </div>
            </div>
                        <div class="col-box1">
                <div class="box-text color-2">
                    <h3 data-aos="fade-up" data-aos-duration="800">Sports & Recreation</h3>
                    <p data-aos="fade-up" data-aos-duration="1200" data-aos-delay="310">Well-equipped spaces and spirited games that nurture teamwork, discipline, and a healthy lifestyle.</p>                    <a  area-label="View Campus Facilities" href="https://jklu.edu.in/campus-life/sports-recreation"
                        data-aos="fade-up" data-aos-duration="800" data-aos-delay="350"><img
                            src="https://jklu.edu.in/siteassets/images/icons/arrow-white.svg" alt="arrow" width="24" height="24"></a>
                </div>
            </div>
            <div class="col-box1">
                <div class="img-block"><img loading="lazy" src="https://jklu.edu.in/uploads/spotlight/sports.webp"
                        class="img-fluid image" alt="Sports & Recreation">
                </div>
            </div>
                        <div class="col-box1">
                <div class="box-text color-3">
                    <h3 data-aos="fade-up" data-aos-duration="800">Clubs & Societies</h3>
                    <p data-aos="fade-up" data-aos-duration="1200" data-aos-delay="310">A wide range of student-led clubs that foster talent, leadership, and shared passions beyond the classroom.</p>                    <a  area-label="View Campus Facilities" href="https://jklu.edu.in/campus-life/clubs-societies"
                        data-aos="fade-up" data-aos-duration="800" data-aos-delay="350"><img
                            src="https://jklu.edu.in/siteassets/images/icons/arrow-white.svg" alt="arrow" width="24" height="24"></a>
                </div>
            </div>
            <div class="col-box1">
                <div class="img-block"><img loading="lazy" src="https://jklu.edu.in/uploads/spotlight/club-pic.webp"
                        class="img-fluid image" alt="Clubs & Societies">
                </div>
            </div>
                        <div class="col-box1">
                <div class="box-text color-4">
                    <h3 data-aos="fade-up" data-aos-duration="800">Life in Jaipur</h3>
                    <p data-aos="fade-up" data-aos-duration="1200" data-aos-delay="300">A city steeped in history, yet brimming with youth, culture, and creativity.</p>                    <a  area-label="View Campus Facilities" href="https://jklu.edu.in/campus-life/life-in-jaipur"
                        data-aos="fade-up" data-aos-duration="800" data-aos-delay="350"><img
                            src="https://jklu.edu.in/siteassets/images/icons/arrow-white.svg" alt="arrow" width="24" height="24"></a>
                </div>
            </div>
            <div class="col-box1">
                <div class="img-block"><img loading="lazy" src="https://jklu.edu.in/uploads/spotlight/life-jaipur.webp"
                        class="img-fluid image" alt="Life in Jaipur">
                </div>
            </div>
            

                </div>
    </div>
</section>

