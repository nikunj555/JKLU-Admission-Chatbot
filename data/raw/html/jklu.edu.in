 <script>   
   $(document).ready(function () {
setTimeout(function () {
    disableJsLinks();
}, 2000);
  

    $(document).on('click', 'a.no-link', function (e) {
        e.preventDefault();
        return false;
    });



document.addEventListener('click', function(event) {
    if (event.target.classList.contains('global_search')) {
        event.preventDefault();
        document.getElementById('globalsearch').submit();
    }
});
$('.global_search').click(function() {
    $('#globalsearch').submit();
});

var path = window.location.href;
    $('.inner_menu a').each(function() {
        if ($(this).attr('href') == path) {
            $(this).closest('li').addClass('active')
        }
    });
document.addEventListener('click', function(event) {
    if (event.target.classList.contains('global_search_mobile')) {
        event.preventDefault();
        document.getElementById('globalsearch_mobile').submit();
    }
});
$('.global_search_mobile').click(function() {
    $('#globalsearch_mobile').submit();
});

});


$(document).ready(function () {

  // Expiry: 3 Jan 2026, 3:00 PM
  var expiryTime = new Date("January 3, 2026 15:00:00").getTime();
  var now = new Date().getTime();

  // If expired, remove modal
  if (now > expiryTime) {
    $('#imageModal').remove();
    return;
  }

  // Show popup only once per session
  if (!sessionStorage.getItem('imageModalClosed')) {
    var modal = new bootstrap.Modal($('#imageModal')[0]);
    modal.show();
  }

  // On close, mark as closed for this session
  $('#imageModal').on('hidden.bs.modal', function () {
    sessionStorage.setItem('imageModalClosed', 'true');
  });

});

function disableJsLinks() {
    $('a').filter(function () {
        return ($(this).attr('href') || '')
            .trim()
            .toLowerCase()
            .startsWith('javascript:');
    }).each(function () {
        $(this)
            .attr('href','')
            .removeAttr('onclick')
            .addClass('no-link');
    });
}
 </script>
