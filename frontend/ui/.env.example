# Frontend environment (no secrets here: anything VITE_* is bundled into the browser!)
# Leave empty when the UI is served by the backend (python run.py). For `npm run dev`, the Vite proxy handles /api.
VITE_API_BASE_URL=
# UI development without the backend. Clearly labelled mock data, never real JKLU information.
VITE_USE_MOCK=false
