# Frontend environment (no secrets here: anything VITE_* is bundled into the browser!)

# For local development with backend running on port 8000 (Vite proxies /api to http://127.0.0.1:8000):
VITE_API_BASE_URL=

# For production on Vercel:
# Set this in Vercel Project Settings -> Environment Variables to your deployed Python backend URL:
# VITE_API_BASE_URL=https://your-backend-service.onrender.com

# UI development with mock responses (offline demo mode):
VITE_USE_MOCK=false
