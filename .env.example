# Copy this file to `.env` and fill in what you need. Everything is optional.
# The model generates the answer; your JKLU corpus and retrieval logic provide the university facts.

# --- LLM Provider Selection ---
# Options: auto | groq | openai | anthropic | gemini | ollama | openrouter | none (extractive)
LLM_PROVIDER=auto

# --- Option 1: Groq (Fast, Free Tier Available at console.groq.com) ---
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# (Other Groq models: openai/gpt-oss-20b, qwen/qwen3.8-27b)

# --- Option 2: OpenAI (gpt-4o-mini, gpt-4o, etc.) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Option 3: Anthropic (Claude) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# --- Option 4: Google Gemini (free tier available at ai.google.dev) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- Option 5: Local Ollama (run `ollama serve` and `ollama pull llama3.2` first) ---
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2

# --- Option 6: OpenRouter or Custom Endpoint (DeepSeek, Together, vLLM, LMStudio) ---
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# CUSTOM_LLM_BASE_URL=
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_MODEL=

# --- RAG Retrieval & Verification Parameters (Preserved) ---
# JKLU_TOP_K=8
# JKLU_MIN_COVERAGE=0.50
# JKLU_MIN_DENSE=0.25
# JKLU_CHUNK_WORDS=130
# JKLU_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# JKLU_LIGHTWEIGHT_MODE=false
# (Set to 'true' if running on a memory-constrained host < 512MB RAM)

# --- Production Deployment & CORS ---
# JKLU_CORS_ORIGINS=*
# (or specific domains: https://your-project.vercel.app,http://localhost:5173)
# JKLU_API_HOST=0.0.0.0
# JKLU_API_PORT=8000
